# WellNest Environment Configuration Template
# Copy this file to .env.local for local overrides. Never commit .env or secrets to version control.

# Application Environment (production / development)
VITE_APP_ENV=production

# Application Base URL
VITE_APP_URL=http://localhost:5173

# Optional: Remote AI Companion API key (Default uses local zero-dependency engine)
# VITE_GEMINI_API_KEY=
# VITE_GROQ_API_KEY=

# Session Security Configuration
VITE_SESSION_TIMEOUT_MINUTES=30
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION_MINUTES=15
